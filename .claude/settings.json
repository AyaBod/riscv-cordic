    "deny": [
      "Bash(rm *)", "Bash(git rm *)", "Bash(mv *)", "Bash(git clean *)",
      "Bash(git reset --hard *)", "Bash(git restore *)", "Bash(git checkout -- *)",
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(rmdir *)"
    ]
  }
