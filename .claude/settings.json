{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write",
      "Bash(git status)", "Bash(git diff *)", "Bash(git diff)", "Bash(git log *)",
      "Bash(git add *)", "Bash(git switch *)", "Bash(git checkout -b *)",
      "Bash(make *)", "Bash(make)", "Bash(cp *)", "Bash(mkdir *)", "Bash(python3 *)"
